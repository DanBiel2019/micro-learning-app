<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIGeneratedAndroid" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Theme.AIGeneratedAndroid.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/bg_dark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/accent</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AIGeneratedAndroid</item>
    </style>
</resources>
